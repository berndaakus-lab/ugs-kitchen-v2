# Same Supabase project as the online app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # only used to subscribe to realtime broadcasts
SUPABASE_SERVICE_ROLE_KEY=            # required — all POS data goes through API routes

# Signs the staff session cookie. Generate with: openssl rand -hex 32
POS_SESSION_SECRET=

# Paystack (same account as online; POS references are prefixed UGSPOS-).
# Also used to look up the name on a customer's MoMo wallet.
PAYSTACK_SECRET_KEY=

# SMS (same Nkomo account as online) — thank-you + review link after payment
NKOMO_API_KEY=
NKOMO_SENDER_ID=UGsKitchen

# Public addresses
POS_PUBLIC_URL=https://pos.ugskitchen.com      # review links in SMS point here
NEXT_PUBLIC_SHOP_URL=https://ugskitchen.com    # "Order again" on the review page
